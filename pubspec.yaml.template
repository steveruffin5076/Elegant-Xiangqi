name: elegant_xiangqi
description: Imperial Silk & Jade - Elegant Traditional Xiangqi Portrait
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'
  flutter: ">=3.22.0"

dependencies:
  flutter:
    sdk: flutter
  flame: ^1.18.0
  hive: ^2.2.3
  hive_flutter: ^1.1.0
  provider: ^6.1.1
  google_fonts: ^6.1.0
  audioplayers: ^5.2.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  hive_generator: ^2.0.1
  build_runner: ^2.4.7

flutter:
  uses-material-design: true
  assets:
    - assets/board/
    - assets/pieces/
    - assets/bg/
    - assets/engine/
